# The @qits scope lives in the platform's own npm repository, not on npmjs. Two lines: everything
# through the npmjs pull-through cache, ours from the hosted one. These are a LOCAL developer's
# addresses (the deployment host publishes them); CI writes the in-network pair from environment
# instead, because a step container has no localhost:8081.
registry=http://localhost:8081/artifacts/npm/npmjs/
@qits:registry=http://localhost:8081/artifacts/npm/npm/
