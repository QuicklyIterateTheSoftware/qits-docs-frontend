# The @qits scope lives in the platform's own npm repository, not on npmjs. Two lines, and since the
# byte-plane split two services: everything through qits-platform-mirror's npmjs pull-through cache
# on mirror.dev.localhost:8080, ours from qits-artifacts' hosted registry on
# registry.dev.localhost:8080. These are a LOCAL developer's addresses (the deployment host
# publishes them through the edge); CI writes the in-network pair from environment instead, because
# a step container has neither.
registry=http://mirror.dev.localhost:8080/artifacts/npm/npmjs/
@qits:registry=http://registry.dev.localhost:8080/artifacts/npm/npm/
