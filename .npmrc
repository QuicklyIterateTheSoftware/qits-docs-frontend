# The @qits scope lives in the platform's own npm repository, not on npmjs. Two lines, and since the
# byte-plane split two services: everything through qits-platform-mirror's npmjs pull-through cache
# on 8082, ours from qits-artifacts' hosted registry on 8081. These are a LOCAL developer's
# addresses (the deployment host publishes them); CI writes the in-network pair from environment
# instead, because a step container has neither.
registry=http://localhost:8082/artifacts/npm/npmjs/
@qits:registry=http://localhost:8081/artifacts/npm/npm/
